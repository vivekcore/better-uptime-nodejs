{
  "name": "@repo/db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "@repo/typescript-config": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.14",
    "dotenv": "^18.0.5",
    "prisma": "^8.0.0-rc.20",
    "temporal-polyfill": "^1.0.5"
  },
  "scripts": {
    "db:schema": "prisma db schema --db $DATABASE_URL",
    "db:init": "prisma contract emit && prisma db init --db $DATABASE_URL",
    "db:verify": "prisma db verify --db $DATABASE_URL"
  },
  "exports": {
    ".": "./src/index.ts"
  }

}
